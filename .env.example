# Django secret key: REQUIRED in production (set it in the Vercel dashboard).
# DJANGO_SECRET_KEY="a long random string"

# Google Gemini API Key for Lexi (AI bot)
GEMINI_API_KEY="your_gemini_api_key_here"

# Database Configuration (Supabase PostgreSQL / local)
# DATABASE_URL="postgresql://postgres:password@aws-0-ap-southeast-2.pooler.supabase.com:6543/postgres"

# Optional: extra host names, comma separated (e.g. a custom domain). Default covers *.vercel.app.
# ALLOWED_HOSTS=".vercel.app,localhost,127.0.0.1,www.example.com"
